# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# lifestream: imported audio + local storage dir (never commit audio)
/imports/
/.storage/

# local tool state (playwright screenshots, session memory)
/.playwright-mcp/
/.remember/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
/.claude/settings.local.json
deploy-plan.html
